# Ubuntu example. Adjust User and both /home/ubuntu paths if needed.
[Unit]
Description=Germany apartment search Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/germany-wohnungsbot
ExecStart=/home/ubuntu/germany-wohnungsbot/.venv/bin/python -m bot.main
Environment=PYTHONUNBUFFERED=1
UMask=0077
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
