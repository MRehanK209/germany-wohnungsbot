# ===== Telegram =====
# Token von @BotFather (Telegram): /newbot -> Token hier einfügen
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID: schreibe deinem Bot eine Nachricht, dann öffne
# https://api.telegram.org/bot<TOKEN>/getUpdates und kopiere "chat":{"id":...}
# (oder nutze python -m bot.wizard, der findet sie automatisch)
TELEGRAM_CHAT_ID=

# ===== Search filters (set by `python -m bot.wizard`) =====
# City to search (default Göttingen). Any German city works, e.g. Berlin, München,
# Hamburg, Frankfurt am Main. Göttingen-only co-ops are skipped for other cities.
SEARCH_CITY=Göttingen
# Optional: if Immowelt / ImmoScout24 can't find your city, search there in the
# browser and paste the result URL here.
# IMMOWELT_SEARCH_URL=
# IMMOSCOUT24_SEARCH_URL=
# Rooms: "3" exact, "3-3.5" range, "2-4", or "3+". Overrides config.yaml.
SEARCH_ROOMS=1
# Minimum living area in m²; 0 disables the minimum.
SEARCH_MIN_SIZE_SQM=28
# Maximum listing age in days; 0 disables it. Undated listings still alert as new.
SEARCH_MAX_AGE_DAYS=7
# Monthly Warmmiete ceiling across platforms, in euros; 0 = no cap.
# Without a stated warm rent, the shown price is used and the alert is flagged.
SEARCH_MAX_WARM_RENT_EUR=600
# Postal codes within SEARCH_CITY to limit to, comma-separated (blank = whole city).
# Göttingen PLZ: 37073 37075 37077 37079 37081 37083 37085
SEARCH_POSTAL_CODES=

# ===== Kleinanzeigen login (for auto-messaging) =====
# Set these with:  python -m bot.credentials   (password entered hidden)
KLEINANZEIGEN_EMAIL=
KLEINANZEIGEN_PASSWORD=

# ===== Personal data used to fill the Kleinanzeigen contact form fields =====
FULL_NAME=
EMAIL=
PHONE=
OCCUPATION=
HOUSEHOLD=
